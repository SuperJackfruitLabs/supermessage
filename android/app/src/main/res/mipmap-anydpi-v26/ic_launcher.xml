<?xml version="1.0" encoding="utf-8"?>
<!--
  The launcher icon: the mark on ink. Every layer is a resource generated from
  design/tokens.toml (res/drawable/ic_launcher_*.xml, res/values/
  generated_theme_colors.xml), so there are no PNGs to regenerate here — and
  anydpi-v26 is enough, because minSdk is 31.

  `monochrome` is what Android 13+ themed icons draw; without it the launcher
  shows the full-colour icon among tinted ones.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/sm_ground_ink" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
