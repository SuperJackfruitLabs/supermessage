<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Day/night with no com.google.android.material or androidx.appcompat
      dependency: neither is declared here (both have bitten this project
      before via a minCompileSdk above compileSdk = 36 — see
      AndroidManifest.xml's own note), so there is no dependency-free
      `DayNight.NoActionBar` sibling to extend. What *is* free is the
      resource-qualifier system itself: `values-night/` has followed
      Configuration.uiMode since API 8, entirely independent of any
      DayNight-named theme class. One style name, defined twice — this file
      for day, `values-night/styles.xml` for night — resolves to the right
      `windowBackground` before Compose paints its first frame, which is the
      whole fix: a cold start under system dark mode no longer shows a white
      window.
    -->
    <style name="Theme.Supermessage" parent="@android:style/Theme.Material.Light.NoActionBar">
        <!--
          Paper's `surface`: what Theme.kt's `Surface` paints on the first
          frame, so the window and the frame agree. A generated resource
          rather than a hex, because resource XML cannot read a Kotlin
          `Color` — this used to be a literal "kept in sync by hand", and it
          went on showing #F6F4EF, a ground from a palette that had already
          been replaced.
        -->
        <item name="android:windowBackground">@color/sm_paper_surface</item>
    </style>
</resources>
