---
// The landing page for supermessage.dev.
//
// Design notes, so the next person changing this knows what is deliberate:
//
// The hero is a room transcript, not a headline over a gradient. The one thing
// that makes this client different is that an agent's turn, its request for
// permission, and a gate waiting on a human all arrive IN the conversation — so
// the hero shows that sequence rather than describing it. Every event type label
// in it is a real one the core renders (`custom_events.rs`), and the roster words
// are the four `AgentState::word` produces. If those change, this page is wrong.
//
// Amber is used for exactly one thing: the item that is waiting on a person.
// Spending the only warm colour on "needs you" is the whole point of the palette.
//
// It follows the visitor's light or dark preference, as the docs do, with both
// palettes generated from design/tokens.toml into ../styles/tokens.css.
const events = [
  { type: 'dev.agentpod.turn.v1', label: 'Turn' },
  { type: 'dev.agentpod.permission.v1', label: 'Permission' },
  { type: 'dev.superpipeline.gate.v1', label: 'Approval' },
];

import '../styles/tokens.css';
import ShareMeta from '../components/ShareMeta.astro';

const title = 'supermessage — chat where your agents are in the room';
const description =
  'A Matrix client where the agents you work with are participants, not a panel. In development for iOS, Android, Windows, macOS and Linux.';
const releases = 'https://github.com/SuperJackfruitLabs/supermessage/releases/latest';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <ShareMeta title={title} description={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,800&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
    />
    <style>
      :root {
        --display: 'Bricolage Grotesque', 'Trebuchet MS', sans-serif;
        --body: 'IBM Plex Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        --mono: 'IBM Plex Mono', ui-monospace, 'SF Mono', Menlo, monospace;
      }

      * { box-sizing: border-box; }

      /* Light, for a visitor whose system asks for it.
       *
       * The docs site follows the reader's preference — Starlight does that by default and
       * documentation read in daylight should stay legible. This page used to be dark only,
       * which meant a visitor on a light system saw a dark landing page and then LIGHT docs:
       * exactly the mismatch that shared colours were supposed to remove.
       *
       * These are the same values as `docs-site/src/styles/theme.css`'s light block, so the
       * two sites agree in both directions rather than only in the dark. */
      /* The light palette itself now arrives from ../styles/tokens.css,
         generated from design/tokens.toml — this page no longer keeps its
         own copy, and no longer approximates it in hsl(). What stays is the
         one thing that is a rule rather than a value: the two chips that sit
         ON a colour need their own foreground, because the accent and the
         amber both darken in light and dark-on-light text would vanish into
         them. `--color-accent-content` is exactly that role, so it needs no
         media query at all. */
      .btn-primary { color: var(--color-accent-content); }
      .opt.yes { color: var(--color-accent-content); }

      body {
        margin: 0;
        background: var(--color-surface-sunken);
        color: var(--color-content);
        font-family: var(--body);
        font-size: 17px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      .wrap { width: 100%; max-width: 1120px; margin: 0 auto; padding: 0 24px; }

      /* ── status bar ─────────────────────────────────────────────── */
      .status {
        background: var(--color-surface);
        border-bottom: 1px solid var(--color-border);
        font-size: 14px;
        color: var(--color-content-muted);
      }
      .status .wrap {
        display: flex; gap: 10px; align-items: center;
        padding-top: 11px; padding-bottom: 11px; flex-wrap: wrap;
      }
      .dot {
        width: 7px; height: 7px; border-radius: 50%;
        background: var(--color-signal); flex: none;
      }
      /* A zero basis keeps the sentence beside its dot. With its natural width it is
         wider than a phone, and the wrap put the dot on a line of its own. */
      .status .wrap > span:last-child { flex: 1 1 0; min-width: 0; }
      .status strong { color: var(--color-content); font-weight: 600; }
      .status a { color: var(--color-content); }

      /* ── masthead ───────────────────────────────────────────────── */
      header.mast .wrap {
        display: flex; align-items: center; justify-content: space-between;
        padding-top: 26px; padding-bottom: 26px; gap: 20px;
      }
      .brand {
        display: flex; align-items: center; gap: 10px;
        font-family: var(--display);
        font-weight: 800; font-size: 21px; letter-spacing: -0.02em;
      }
      .brand img { width: 32px; height: auto; flex: none; }
      .brand .word span { color: var(--color-accent); }
      nav { display: flex; gap: 22px; font-size: 15px; }
      nav a { color: var(--color-content-muted); text-decoration: none; }
      nav a:hover, nav a:focus-visible { color: var(--color-content); }

      /* ── hero ───────────────────────────────────────────────────── */
      .hero .wrap {
        display: grid; grid-template-columns: 1fr 1fr;
        gap: 64px; align-items: center;
        padding-top: 56px; padding-bottom: 88px;
      }
      h1 {
        font-family: var(--display);
        font-weight: 800;
        font-size: clamp(2.4rem, 5vw, 3.9rem);
        line-height: 1.04;
        letter-spacing: -0.035em;
        margin: 0 0 22px;
        text-wrap: balance;
      }
      h1 em { font-style: normal; color: var(--color-accent); }
      .lede {
        font-size: 1.16rem; color: var(--color-content-muted);
        margin: 0 0 32px; max-width: 30em;
      }
      .actions { display: flex; gap: 12px; flex-wrap: wrap; }
      .btn {
        display: inline-block; padding: 13px 22px; border-radius: 9px;
        font-weight: 600; font-size: 15px; text-decoration: none;
        border: 1px solid transparent;
      }
      .btn-primary { background: var(--color-accent); color: var(--color-accent-content); }
      .btn-primary:hover { background: var(--color-accent-soft); }
      .btn-ghost { border-color: var(--color-border); color: var(--color-content); }
      .btn-ghost:hover { border-color: var(--color-accent); }

      /* ── the transcript: this page's signature ──────────────────── */
      .room {
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 15px;
        overflow: hidden;
      }
      .room-head {
        display: flex; align-items: center; gap: 9px;
        padding: 13px 16px; border-bottom: 1px solid var(--color-border);
        font-size: 14px; color: var(--color-content-muted);
      }
      .room-head b { color: var(--color-content); font-weight: 600; }
      .pill {
        margin-left: auto; font-family: var(--mono); font-size: 11px;
        color: var(--color-signal); border: 1px solid var(--color-signal);
        border-radius: 999px; padding: 2px 9px;
        /* At phone width the header ran out of room and this wrapped to two lines —
           the one label on the card that must read at a glance. */
        white-space: nowrap;
      }
      .msgs { padding: 16px; display: flex; flex-direction: column; gap: 13px; }
      .msg { display: flex; flex-direction: column; gap: 4px; }
      .who { font-size: 13px; color: var(--color-content-muted); }
      .who b { color: var(--color-content); font-weight: 600; }
      .bubble {
        background: var(--color-surface-raised); border-radius: 11px;
        padding: 10px 13px; font-size: 15px;
      }

      /* a suite event, as the client renders one */
      .card {
        border: 1px solid var(--color-border); border-left: 3px solid var(--color-accent);
        border-radius: 9px; background: var(--color-surface-raised); padding: 11px 13px;
      }
      .card.awaiting { border-left-color: var(--color-signal); }
      .etype {
        font-family: var(--mono); font-size: 11px; color: var(--color-content-muted);
        display: block; margin-bottom: 7px;
      }
      .field { display: flex; gap: 8px; font-size: 14.5px; margin-bottom: 3px; }
      .field .k { color: var(--color-content-muted); flex: none; min-width: 4.6em; }
      .prompt { font-size: 14.5px; margin-top: 8px; }
      .opts { display: flex; gap: 8px; margin-top: 10px; flex-wrap: wrap; }
      .opt {
        font-size: 13px; font-weight: 600; padding: 6px 13px;
        border-radius: 7px; border: 1px solid var(--color-border); color: var(--color-content);
      }
      .opt.yes { background: var(--color-signal); color: var(--color-signal-soft); border-color: var(--color-signal); }
      .fallback {
        font-size: 12.5px; color: var(--color-content-muted);
        border-top: 1px dashed var(--color-border); margin-top: 10px; padding-top: 8px;
        font-style: italic;
      }

      /* ── sections ───────────────────────────────────────────────── */
      section.band { border-top: 1px solid var(--color-border); }
      section.band .wrap { padding-top: 72px; padding-bottom: 72px; }
      h2 {
        font-family: var(--display); font-weight: 600;
        font-size: clamp(1.6rem, 3vw, 2.1rem); letter-spacing: -0.025em;
        margin: 0 0 14px; text-wrap: balance;
      }
      .sub { color: var(--color-content-muted); margin: 0 0 40px; max-width: 62ch; }
      .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 26px; }
      .cell h3 {
        font-family: var(--display); font-size: 1.13rem; font-weight: 600;
        margin: 0 0 8px; letter-spacing: -0.015em;
      }
      .cell p { margin: 0; color: var(--color-content-muted); font-size: 15.5px; }
      .cell a { color: var(--color-accent); }

      /* roster states */
      .states { display: flex; flex-direction: column; gap: 0; margin: 0; padding: 0; list-style: none; }
      .states li {
        display: flex; gap: 16px; align-items: baseline;
        padding: 15px 0; border-bottom: 1px solid var(--color-border);
      }
      .states li:first-child { border-top: 1px solid var(--color-border); }
      .states .word {
        font-family: var(--mono); font-size: 13px; color: var(--color-accent);
        flex: none; min-width: 9em;
      }
      .states li:first-child .word { color: var(--color-signal); }
      .states .what { color: var(--color-content-muted); font-size: 15.5px; }
      .caveat {
        margin-top: 26px; padding: 15px 17px; border-radius: 9px;
        background: var(--color-surface); border: 1px solid var(--color-border);
        font-size: 15px; color: var(--color-content-muted);
      }
      .caveat b { color: var(--color-content); font-weight: 600; }

      .platforms {
        display: flex; gap: 10px; flex-wrap: wrap; list-style: none;
        margin: 0; padding: 0;
      }
      .platforms li {
        font-family: var(--mono); font-size: 13px; color: var(--color-content);
        border: 1px solid var(--color-border); border-radius: 7px; padding: 7px 14px;
        background: var(--color-surface);
      }

      footer { border-top: 1px solid var(--color-border); }
      footer .wrap {
        display: flex; justify-content: space-between; gap: 20px; flex-wrap: wrap;
        padding-top: 34px; padding-bottom: 46px;
        font-size: 14.5px; color: var(--color-content-muted);
      }
      footer a { color: var(--color-content-muted); }
      footer a:hover { color: var(--color-content); }
      .fnav { display: flex; gap: 20px; flex-wrap: wrap; }

      @media (max-width: 860px) {
        .hero .wrap { grid-template-columns: 1fr; gap: 44px; padding-bottom: 60px; }
        .grid { grid-template-columns: 1fr; gap: 30px; }
        .states li { flex-direction: column; gap: 3px; }
      }

      /* Below this the room name, the head count and the pill do not fit on one line.
         The count is the one of the three the transcript does not need. */
      @media (max-width: 480px) {
        .room-head .count { display: none; }
      }

      @media (prefers-reduced-motion: reduce) {
        * { transition: none !important; animation: none !important; }
      }
    </style>
  </head>

  <body>
    <div class="status">
      <div class="wrap">
        <span class="dot" aria-hidden="true"></span>
        <span><strong>In development.</strong> Unsigned desktop previews for macOS, Windows and
        Linux are on <a href={releases}>GitHub Releases</a>; there is no public iOS or Android
        build yet.</span>
      </div>
    </div>

    <header class="mast">
      <div class="wrap">
        <!-- The mark is generated from design/tokens.toml, and it is the same file as the
             favicon. Empty alt: the wordmark beside it already says the name. -->
        <div class="brand"><img src="/favicon.svg" alt="" width="32" height="28" /><span
          class="word">super<span>message</span></span></div>
        <nav>
          <a href="https://docs.supermessage.dev">Docs</a>
          <a href="https://github.com/SuperJackfruitLabs/supermessage">Source</a>
        </nav>
      </div>
    </header>

    <div class="hero">
      <div class="wrap">
        <div>
          <h1>Chat where your agents are <em>in the room</em>.</h1>
          <p class="lede">
            supermessage is a Matrix client built for teams whose colleagues include machines. An
            agent's work, the permission it needs, and the decision waiting on you all arrive in
            the conversation — in order, next to what everyone else said.
          </p>
          <div class="actions">
            <a class="btn btn-primary" href="https://docs.supermessage.dev">Read the docs</a>
            <a
              class="btn btn-ghost"
              href="https://github.com/SuperJackfruitLabs/supermessage">View the source</a>
          </div>
        </div>

        <!-- The signature element. See the design note at the top of this file. -->
        <div class="room" role="img"
          aria-label="A room transcript: a person asks about a migration; an agent reports what it did; the agent asks permission to run the migration against staging, offering Allow once or Reject; and a superpipeline gate waits for an approval, with Approve, Request changes and Reject.">
          <div class="room-head">
            <b>#billing-migration</b>
            <span class="count">3 people · 2 agents</span>
            <span class="pill">needs you</span>
          </div>
          <div class="msgs">
            <div class="msg">
              <div class="who"><b>Priya</b></div>
              <div class="bubble">Where did the migration get to?</div>
            </div>

            <div class="msg">
              <div class="who"><b>coder-kai</b> · agent</div>
              <div class="card">
                <span class="etype">{events[0].type}</span>
                <div class="field"><span class="k">Did</span><span
                  >Rewrote 14 call sites, ran the suite — 556 pass</span></div>
                <div class="fallback">Element shows: “coder-kai: rewrote 14 call sites, 556
                  tests pass.”</div>
              </div>
            </div>

            <div class="msg">
              <div class="who"><b>coder-kai</b> · agent</div>
              <div class="card awaiting">
                <span class="etype">{events[1].type}</span>
                <div class="field"><span class="k">Wants to</span><span
                  >run the migration against staging</span></div>
                <!-- The prompt is PermissionRequestRenderer's own ("Allow {title}?"), and
                     the buttons are whatever options the agent sent — these two are the
                     ones the core's own tests use. -->
                <div class="prompt">Allow run the migration against staging?</div>
                <div class="opts">
                  <span class="opt yes">Allow once</span>
                  <span class="opt">Reject</span>
                </div>
              </div>
            </div>

            <div class="msg">
              <div class="who"><b>superpipeline</b></div>
              <div class="card awaiting">
                <span class="etype">{events[2].type}</span>
                <div class="field"><span class="k">Card</span><span>Billing migration</span></div>
                <div class="field"><span class="k">Stage</span><span>Awaiting review</span></div>
                <!-- A gate's three answers are fixed: superpipeline resolves exactly
                     approve | request_changes | reject (GATE_OPTION_IDS). -->
                <div class="opts">
                  <span class="opt yes">Approve</span>
                  <span class="opt">Request changes</span>
                  <span class="opt">Reject</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <section class="band">
      <div class="wrap">
        <h2>Participants, not a panel</h2>
        <p class="sub">
          Most tools put an agent in a sidebar — a chat box bolted onto an app, separate from the
          conversation your team is actually having. This puts it in the room, and gives each kind
          of event a shape you can read at a glance.
        </p>
        <div class="grid">
          <div class="cell">
            <h3>Turns</h3>
            <p>What an agent did during one stretch of work. Live output streams while it writes;
              the durable record is the message that lands when it finishes.</p>
          </div>
          <div class="cell">
            <h3>Permission</h3>
            <p>An agent asking before it acts. You answer in the room, and the answer stays
              attached — so the record of who decided what lives where it was decided.</p>
          </div>
          <div class="cell">
            <h3>Approval gates</h3>
            <p>Work does not simply continue because an agent thinks it should. A gate is a card
              that has reached a point a person has to answer.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="band">
      <div class="wrap">
        <h2>A roster that knows what is waiting on you</h2>
        <p class="sub">
          A room of agents fills up faster than a room of people, and “most recent first” stops
          helping quickly. Sort by what owes you an answer, or group by the machine an agent runs
          on.
        </p>
        <ul class="states">
          <li><span class="word">needs you</span><span class="what">Owes you an answer</span></li>
          <li><span class="word">active</span><span class="what">Spoke recently enough to
            count</span></li>
          <li><span class="word">idle</span><span class="what">Nothing lately, but within living
            memory</span></li>
          <li><span class="word">quiet</span><span class="what">Silent long enough that its
            absence is the fact</span></li>
        </ul>
        <p class="caveat">
          <b>This is not a health check.</b> None of those four says whether a process is running —
          each is a statement about when the room last spoke, or about what it said. Whether the
          machine is actually up is a different question, and a different tool answers it.
        </p>
      </div>
    </section>

    <section class="band">
      <div class="wrap">
        <h2>It does not stop being Matrix</h2>
        <p class="sub">
          A constraint the project holds itself to, not a side effect. Every custom event carries a
          plain-text fallback body, so the same rooms stay usable from Element, Cinny, or anything
          else. Nothing here locks a room, a homeserver, or the people in it to this client.
        </p>
        <div class="grid">
          <div class="cell">
            <h3>Encrypted by default</h3>
            <p>End-to-end encryption through the Matrix Rust SDK and vodozemac. One exception: a
              room created with an agent invited stays unencrypted, so an agent that cannot
              decrypt is never locked out of it. <a
              href="https://docs.supermessage.dev/use/encryption/">Why</a>.</p>
          </div>
          <div class="cell">
            <h3>Your homeserver</h3>
            <p>Point it anywhere. supermessage is a client — it keeps no central store of its
              own.</p>
          </div>
          <div class="cell">
            <h3>One core, many screens</h3>
            <p>A Rust core decides what a timeline item is and how it should read. Each platform
              renders that decision instead of re-deriving it.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="band">
      <div class="wrap">
        <h2>Five platforms, one core</h2>
        <p class="sub">
          Mobile and desktop are equally weighted. iOS is SwiftUI and Android is Compose, both over
          the Rust core through UniFFI; the desktop app is Svelte in a Tauri window, over the same
          core.
        </p>
        <ul class="platforms">
          <li>iOS</li><li>Android</li><li>macOS</li><li>Windows</li><li>Linux</li>
        </ul>
      </div>
    </section>

    <footer>
      <div class="wrap">
        <span>supermessage · in development · MIT</span>
        <span class="fnav">
          <a href="https://docs.supermessage.dev">Documentation</a>
          <a href="https://github.com/SuperJackfruitLabs/supermessage">GitHub</a>
          <a href="https://docs.agentpod.dev">AgentPod</a>
          <a href="https://docs.superpipeline.dev">superpipeline</a>
          <a href="/privacy/">Privacy</a>
          <a href="/delete-account/">Delete account</a>
        </span>
      </div>
    </footer>
  </body>
</html>
