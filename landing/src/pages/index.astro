---
// The landing page for supermessage.dev.
//
// Design notes, so the next person changing this knows what is deliberate:
//
// The hero is a room transcript, not a headline over a gradient. The one thing
// that makes this client different is that an agent's turn, its request for
// permission, and a gate waiting on a human all arrive IN the conversation — so
// the hero shows that sequence rather than describing it. Every event type label
// in it is a real one the core renders (`custom_events.rs`). The names and
// numbers in it are invented, and the page says so under it.
//
// Amber is used for exactly one thing: the item that is waiting on a person.
//
// Every capability sentence here maps to an entry in the SJL claims ledger
// (sjl-marketing foundation/products.md, SM-01..SM-05). Those entries are
// `limited`, and their caveats sit in the same section as the claim. Do not
// add a claim without a ledger entry, and do not drop a caveat to tidy a line.
//
// Theme: follows the visitor's preference, and the #theme button overrides it
// (data-theme on <html>, remembered in localStorage). The override blocks are
// derived at build time from the generated tokens.css, so nothing is copied.
const events = [
  { type: 'dev.agentpod.turn.v1', label: 'Turn' },
  { type: 'dev.agentpod.permission.v1', label: 'Permission' },
  { type: 'dev.superpipeline.gate.v1', label: 'Approval' },
];

import '../styles/tokens.css';
import tokensRaw from '../styles/tokens.css?raw';
import ShareMeta from '../components/ShareMeta.astro';

// Pull the dark (:root) and light (@media light > :root) declarations out of the
// generated file and re-scope them to an explicit data-theme.
const decls = (block: string) => block.replace(/\/\*[\s\S]*?\*\//g, '');
const darkBlock = tokensRaw.match(/^:root\s*\{([\s\S]*?)\n\}/m)?.[1] ?? '';
const lightBlock =
  tokensRaw.match(/@media \(prefers-color-scheme: light\)\s*\{\s*:root\s*\{([\s\S]*?)\n  \}/)?.[1] ?? '';
const themeCss =
  `:root[data-theme="dark"]{${decls(darkBlock)}}\n:root[data-theme="light"]{${decls(lightBlock)}}`;

// The latest PUBLISHED release. One constant, so a new release is a one-line change.
// Ledger SM-04 names v0.0.15 (2026-09-30), unsigned desktop builds only.
const latestRelease = 'v0.0.15';
const releaseUrl = `https://github.com/SuperJackfruitLabs/supermessage/releases/tag/${latestRelease}`;
const docs = 'https://docs.supermessage.dev';
// There is no install page in the docs yet; "What SuperMessage is" is the start page.
const getStarted = `${docs}/start/what-it-is/`;

const title = 'SuperMessage — chat where your agents are in the room';
const description =
  'A Matrix client where agent turns, permission requests and approval gates arrive as cards in the room. In development: unsigned desktop previews only, no public mobile build.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <ShareMeta title={title} description={description} />
    <script is:inline>
      try {
        var t = localStorage.getItem('sm-theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,800&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
    />
    <style is:global set:html={themeCss}></style>
    <style>

      :root {
        --display: 'Bricolage Grotesque', 'Trebuchet MS', sans-serif;
        --body: 'IBM Plex Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        --mono: 'IBM Plex Mono', ui-monospace, 'SF Mono', Menlo, monospace;
      }

      * { box-sizing: border-box; }

      /* Light, for a visitor whose system asks for it.
       *
       * The docs site follows the reader's preference — Starlight does that by default and
       * documentation read in daylight should stay legible. This page used to be dark only,
       * which meant a visitor on a light system saw a dark landing page and then LIGHT docs:
       * exactly the mismatch that shared colours were supposed to remove.
       *
       * These are the same values as `docs-site/src/styles/theme.css`'s light block, so the
       * two sites agree in both directions rather than only in the dark. */
      /* The light palette itself now arrives from ../styles/tokens.css,
         generated from design/tokens.toml — this page no longer keeps its
         own copy, and no longer approximates it in hsl(). What stays is the
         one thing that is a rule rather than a value: the two chips that sit
         ON a colour need their own foreground, because the accent and the
         amber both darken in light and dark-on-light text would vanish into
         them. `--color-accent-content` is exactly that role, so it needs no
         media query at all. */
      .btn-primary { color: var(--color-accent-content); }
      .opt.yes { color: var(--color-accent-content); }

      body {
        margin: 0;
        background: var(--color-surface-sunken);
        color: var(--color-content);
        font-family: var(--body);
        font-size: 17px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      .wrap { width: 100%; max-width: 1120px; margin: 0 auto; padding: 0 24px; }

      /* ── masthead ───────────────────────────────────────────────── */
      header.mast .wrap {
        display: flex; align-items: center; justify-content: space-between;
        padding-top: 26px; padding-bottom: 26px; gap: 20px;
      }
      .brand {
        display: flex; align-items: center; gap: 10px;
        font-family: var(--display);
        font-weight: 800; font-size: 21px; letter-spacing: -0.02em;
      }
      .brand img { width: 32px; height: auto; flex: none; }
      .brand .word span { color: var(--color-accent); }
      nav { display: flex; gap: 22px; font-size: 15px; }
      nav a { color: var(--color-content-muted); text-decoration: none; }
      nav a:hover, nav a:focus-visible { color: var(--color-content); }
      nav { align-items: center; }
      #theme {
        font: inherit; font-size: 14px; cursor: pointer;
        background: none; color: var(--color-content-muted);
        border: 1px solid var(--color-border); border-radius: 7px; padding: 4px 10px;
      }
      #theme:hover, #theme:focus-visible { color: var(--color-content); border-color: var(--color-accent); }

      /* ── hero (shared spec, 2026-10-21) ─────────────────────────── */
      .hero .wrap {
        max-width: 1080px; margin: 0 auto; padding: 0 24px;
      }
      .hero .hero-grid {
        display: grid; grid-template-columns: minmax(0, 1fr) 500px;
        gap: 56px; align-items: center;
        min-height: calc(100svh - 108px); padding: 56px 24px 72px;
      }
      h1 {
        font-family: var(--display);
        font-weight: 800;
        font-size: clamp(40px, 4.6vw, 60px);
        line-height: 1.04;
        letter-spacing: -0.02em;
        margin: 0;
        max-width: 12ch;
      }
      h1 em { font-style: normal; color: var(--color-accent); }
      .lede {
        font-family: var(--body);
        font-size: 18px; line-height: 1.55; color: var(--color-content-muted);
        margin: 20px 0 28px; max-width: 34em;
      }
      .actions { display: flex; gap: 12px; flex-wrap: wrap; }
      .btn {
        display: inline-flex; align-items: center; justify-content: center;
        height: 46px; padding: 0 20px; border-radius: 10px;
        font: 600 15px var(--body); text-decoration: none;
        border: 1px solid transparent;
      }
      .btn-primary { background: var(--color-accent); color: var(--color-accent-content); }
      .btn-primary:hover { filter: brightness(1.08); }
      .btn-ghost { background: transparent; border-color: var(--color-border); color: var(--color-content); }
      .btn-ghost:hover { border-color: var(--color-accent); }
      .preview-link {
        display: inline-block; margin-top: 16px; font-size: 14px;
        color: var(--color-content-muted);
      }
      .preview-link:hover { color: var(--color-content); }
      .hero-demo { width: 500px; max-width: 100%; }
      .hero-demo .example { margin: 10px 0 0; }

      /* ── the transcript: this page's signature ──────────────────── */
      .room {
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 15px;
        overflow: hidden;
      }
      .room-head {
        display: flex; align-items: center; gap: 9px;
        padding: 13px 16px; border-bottom: 1px solid var(--color-border);
        font-size: 14px; color: var(--color-content-muted);
      }
      .room-head b { color: var(--color-content); font-weight: 600; }
      .pill {
        margin-left: auto; font-family: var(--mono); font-size: 11px;
        color: var(--color-signal); border: 1px solid var(--color-signal);
        border-radius: 999px; padding: 2px 9px;
        /* At phone width the header ran out of room and this wrapped to two lines —
           the one label on the card that must read at a glance. */
        white-space: nowrap;
      }
      .msgs { padding: 16px; display: flex; flex-direction: column; gap: 13px; }
      .msg { display: flex; flex-direction: column; gap: 4px; }
      .who { font-size: 13px; color: var(--color-content-muted); }
      .who b { color: var(--color-content); font-weight: 600; }
      .bubble {
        background: var(--color-surface-raised); border-radius: 11px;
        padding: 10px 13px; font-size: 15px;
      }

      /* a suite event, as the client renders one */
      .card {
        border: 1px solid var(--color-border); border-left: 3px solid var(--color-accent);
        border-radius: 9px; background: var(--color-surface-raised); padding: 11px 13px;
      }
      .card.awaiting { border-left-color: var(--color-signal); }
      .etype {
        font-family: var(--mono); font-size: 11px; color: var(--color-content-muted);
        display: block; margin-bottom: 7px;
      }
      .field { display: flex; gap: 8px; font-size: 14.5px; margin-bottom: 3px; }
      .field .k { color: var(--color-content-muted); flex: none; min-width: 4.6em; }
      .prompt { font-size: 14.5px; margin-top: 8px; }
      .opts { display: flex; gap: 8px; margin-top: 10px; flex-wrap: wrap; }
      .opt {
        font-size: 13px; font-weight: 600; padding: 6px 13px;
        border-radius: 7px; border: 1px solid var(--color-border); color: var(--color-content);
      }
      .opt.yes { background: var(--color-signal); color: var(--color-signal-soft); border-color: var(--color-signal); }
      .fallback {
        font-size: 12.5px; color: var(--color-content-muted);
        border-top: 1px dashed var(--color-border); margin-top: 10px; padding-top: 8px;
        font-style: italic;
      }

      /* ── sections ───────────────────────────────────────────────── */
      section.band { border-top: 1px solid var(--color-border); }
      /* One content layout for every section below the hero (LAYOUT-SPEC, 2026-10-21):
         the hero's container, one left edge, no centred narrow columns. */
      section.band .wrap { max-width: 1080px; margin: 0 auto; padding: 88px 24px; text-align: left; }
      h2 {
        font-family: var(--display); font-weight: 600;
        font-size: clamp(28px, 3vw, 36px); line-height: 1.15; letter-spacing: -0.025em;
        margin: 0 0 12px; text-wrap: balance;
      }
      .sub { color: var(--color-content-muted); font-size: 17px; line-height: 1.6; margin: 0 0 32px; max-width: 640px; }
      .band .wrap > p, .band .wrap > ul, .band .wrap > ol:not(.grid) { max-width: 680px; }
      .band pre { max-width: 760px; }
      .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; }
      .cell h3 {
        font-family: var(--display); font-size: 18px; font-weight: 600;
        margin: 10px 0 6px; letter-spacing: -0.015em;
      }
      .cell p { margin: 0; color: var(--color-content-muted); font-size: 15.5px; }
      .cell a { color: var(--color-accent); }

      .example {
        font-family: var(--mono); font-size: 12px; color: var(--color-content-muted);
        margin: 10px 2px 0;
      }
      .steps { list-style: none; margin: 0; padding: 0; counter-reset: step; }
      .steps li { counter-increment: step; }
      .steps li::before {
        content: counter(step); display: block;
        font-family: var(--mono); font-size: 13px; color: var(--color-accent);
      }
      .prose p { margin: 0 0 16px; }
      .prose a, .limits a { color: var(--color-accent); }
      .assets { list-style: none; margin: 0 0 20px; padding: 0; }
      .assets li { padding: 10px 0; border-bottom: 1px solid var(--color-border); }
      .assets li:first-child { border-top: 1px solid var(--color-border); }
      .assets b { display: inline-block; min-width: 6.5em; font-weight: 600; }
      code {
        font-family: var(--mono); font-size: 0.86em;
        background: var(--color-surface); border: 1px solid var(--color-border);
        border-radius: 5px; padding: 1px 6px; overflow-wrap: anywhere;
      }
      .limits { margin: 0; padding: 0; list-style: none; max-width: 680px; }
      .limits li { margin-bottom: 12px; color: var(--color-content-muted); }
      .limits b { color: var(--color-content); font-weight: 600; }

      footer { border-top: 1px solid var(--color-border); }
      footer .wrap {
        display: flex; justify-content: space-between; gap: 20px; flex-wrap: wrap;
        padding-top: 34px; padding-bottom: 46px;
        font-size: 14.5px; color: var(--color-content-muted);
      }
      footer a { color: var(--color-content-muted); }
      footer a:hover { color: var(--color-content); }
      .fnav { display: flex; gap: 20px; flex-wrap: wrap; }

      @media (max-width: 899px) {
        .grid { grid-template-columns: 1fr; gap: 32px; }
        section.band .wrap { padding-top: 64px; padding-bottom: 64px; }
      }

      /* Below this the room name, the head count and the pill do not fit on one line.
         The count is the one of the three the transcript does not need. */
      @media (max-width: 899px) {
        .hero .hero-grid { grid-template-columns: 1fr; gap: 40px; min-height: auto; padding: 40px 24px 56px; }
        .hero-demo { width: 100%; }
      }

      @media (max-width: 480px) {
        .room-head .count { display: none; }
      }

      @media (prefers-reduced-motion: reduce) {
        * { transition: none !important; animation: none !important; }
      }
        </style>
  </head>

  <body>
    <header class="mast">
      <div class="wrap">
        <!-- The mark is generated from design/tokens.toml, and it is the same file as the
             favicon. Empty alt: the wordmark beside it already says the name. -->
        <div class="brand"><img src="/favicon.svg" alt="" width="32" height="28" /><span
          class="word">Super<span>Message</span></span></div>
        <nav>
          <a href={docs}>Docs</a>
          <a href="https://github.com/SuperJackfruitLabs/supermessage">Source</a>
          <button id="theme" type="button" aria-label="Switch light and dark theme">Theme</button>
        </nav>
      </div>
    </header>

    <section class="hero">
      <div class="wrap hero-grid">
        <div>
          <h1>Chat where your agents are <em>in the room</em>.</h1>
          <p class="lede">
            SuperMessage is a Matrix client in development. When an agent finishes a turn, asks
            permission, or reaches an approval gate, that arrives as a card in the room, next to
            what everyone else said.
          </p>
          <div class="actions">
            <a class="btn btn-primary" href={getStarted}>Get started</a>
            <a class="btn btn-ghost" href={docs}>Docs</a>
          </div>
          <a class="preview-link" href={releaseUrl}>Desktop preview {latestRelease} (unsigned)</a>
        </div>

        <div class="hero-demo">
          <!-- The signature element. See the design note at the top of this file. -->
          <div class="room" role="img"
            aria-label="An example room transcript: an agent reports what it did; the agent asks permission to run the migration against staging, offering Allow once or Reject; and a SuperPipeline gate waits for an approval, with Approve, Request changes and Reject.">
            <div class="room-head">
              <b>#billing-migration</b>
              <span class="count">3 people · 2 agents</span>
              <span class="pill">needs you</span>
            </div>
            <div class="msgs">
              <div class="msg">
                <div class="who"><b>coder-kai</b> · agent</div>
                <div class="card">
                  <span class="etype">{events[0].type}</span>
                  <div class="field"><span class="k">Did</span><span
                    >Rewrote 14 call sites, ran the suite — 556 pass</span></div>
                  <div class="fallback">Element shows: “coder-kai: rewrote 14 call sites, 556
                    tests pass.”</div>
                </div>
              </div>

              <div class="msg">
                <div class="who"><b>coder-kai</b> · agent</div>
                <div class="card awaiting">
                  <span class="etype">{events[1].type}</span>
                  <div class="field"><span class="k">Wants to</span><span
                    >run the migration against staging</span></div>
                  <!-- The prompt is PermissionRequestRenderer's own ("Allow {title}?"), and
                       the buttons are whatever options the agent sent. -->
                  <div class="prompt">Allow run the migration against staging?</div>
                  <div class="opts">
                    <span class="opt yes">Allow once</span>
                    <span class="opt">Reject</span>
                  </div>
                </div>
              </div>

              <div class="msg">
                <div class="who"><b>SuperPipeline</b></div>
                <div class="card awaiting">
                  <span class="etype">{events[2].type}</span>
                  <div class="field"><span class="k">Card</span><span>Billing migration</span></div>
                  <div class="field"><span class="k">Stage</span><span>Awaiting review</span></div>
                  <!-- A gate's three answers are fixed: approve | request_changes | reject. -->
                  <div class="opts">
                    <span class="opt yes">Approve</span>
                    <span class="opt">Request changes</span>
                    <span class="opt">Reject</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <p class="example">Example room. The people, agents and numbers are made up.</p>
        </div>
      </div>
    </section>

    <section class="band">
      <div class="wrap">
        <h2>How it works</h2>
        <ol class="grid steps">
          <li class="cell">
            <h3>Sign in to a Matrix homeserver</h3>
            <p>Any homeserver, with a password. SuperMessage is a client and keeps no store of
              its own; the people you talk to can use Element or Cinny.</p>
          </li>
          <li class="cell">
            <h3>Agents post into the room</h3>
            <p>SuperMessage does not run agents. Agents running under AgentPod post turns and
              permission requests; SuperPipeline posts approval gates. Each renders as a card,
              and only as well as what the sender included.</p>
          </li>
          <li class="cell">
            <h3>You answer on the card</h3>
            <p>Answered is not resolved. After you choose, a gate card reads “waiting for the
              board” until the board's receipt arrives in the room. That needs the AgentPod
              application service; ordinary chat does not.</p>
          </li>
        </ol>
      </div>
    </section>

    <section class="band">
      <div class="wrap prose">
        <h2>What it's like to use</h2>
        <p>
          Say you ask in a room where a migration got to. The agent working on it answers with a
          turn card: what it did in that stretch of work. While it is still writing, you see its
          output live; that live text travels as temporary to-device messages, is not stored in
          room history, and is not end-to-end encrypted. Only the finished turn stays.
        </p>
        <p>
          Next it asks to run the migration against staging. The permission card shows the
          options it sent, say Allow once and Reject, and you tap one. Then the board posts an
          approval gate. You choose Approve, and the card says “waiting for the board” rather than
          “Approved”, because your answer has been sent but not yet accepted. When the receipt
          from the identity that posted the gate lands, the card becomes a receipt naming who
          decided.
        </p>
        <p>
          A colleague in the same room on Element sees each card as a plain sentence instead.
          Nothing about the room depends on SuperMessage.
        </p>
      </div>
    </section>

    <section class="band">
      <div class="wrap prose">
        <h2>Run it yourself</h2>
        <p>
          Download the desktop preview from <a href={releaseUrl}>{latestRelease} on GitHub
          Releases</a> (published 2026-09-30):
        </p>
        <ul class="assets">
          <li><b>macOS</b> <code>supermessage_0.0.15_universal.dmg</code></li>
          <li><b>Windows</b> <code>supermessage_0.0.15_x64-setup.exe</code> or <code>.msi</code></li>
          <li><b>Linux</b> <code>.deb</code>, <code>.rpm</code> or <code>.AppImage</code> (x86-64)</li>
        </ul>
        <p>
          The builds are unsigned, so macOS Gatekeeper and Windows SmartScreen will warn before
          they open. Sign in with your Matrix ID and password on your homeserver. That is all
          ordinary chat needs. Agent cards need agents that post them (AgentPod, SuperPipeline),
          and resolving a gate from the room needs the AgentPod application service and its
          mapping of people to identities.
        </p>
        <p>
          There is nothing to install on a phone: no App Store, Play or public TestFlight build
          exists. To build from source, the <a
          href="https://github.com/SuperJackfruitLabs/supermessage#readme">README</a> has the
          commands.
        </p>
      </div>
    </section>

    <section class="band">
      <div class="wrap">
        <h2>Where it runs today</h2>
        <ul class="limits">
          <li><b>In development.</b> The only public builds are the unsigned desktop previews for
            macOS, Windows and Linux. iOS goes to TestFlight internal testing only, and Android has
            no public build. Mobile features exist in source, not as downloads.</li>
          <li><b>Core chat is in the source for desktop, iOS and Android.</b> Settings differ by
            platform, search is the homeserver's search, and parity with general-purpose Matrix
            clients has not been tested.</li>
          <li><b>Encryption is on by default, through the Matrix Rust SDK, with exceptions.</b> A
            room SuperMessage creates with an agent invited is unencrypted; rooms AgentPod opens
            follow AgentPod's setting; live agent output is not end-to-end encrypted. No
            new-device history test on a named build is recorded. <a
            href={`${docs}/use/encryption/`}>Encryption docs</a>.</li>
          <li><b>Gate answers are not verified end to end.</b> Sending a decision is implemented on
            all three clients; no public live test of a gate resolving is recorded.</li>
          <li><b>A card shows what the sender sent.</b> A failed turn renders as an error card only
            when AgentPod attached the details, and a rendered card does not prove delivery in
            your setup.</li>
        </ul>
      </div>
    </section>

    <footer>
      <div class="wrap">
        <span>SuperMessage · in development · MIT · a <a
          href="https://superjackfruit.com">Super Jackfruit Labs</a> project</span>
        <span class="fnav">
          <a href={docs}>Docs</a>
          <a href="https://github.com/SuperJackfruitLabs/supermessage">Source</a>
          <a href="/support/">Support</a>
          <a href="/terms/">Terms</a>
          <a href="/privacy/">Privacy</a>
          <a href="/delete-account/">Delete account</a>
        </span>
      </div>
    </footer>

    <script is:inline>
      (function () {
        var root = document.documentElement;
        var btn = document.getElementById('theme');
        if (!btn) return;
        function current() {
          return root.dataset.theme ||
            (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        }
        function label() { btn.textContent = current() === 'light' ? 'Dark' : 'Light'; }
        label();
        btn.addEventListener('click', function () {
          var next = current() === 'light' ? 'dark' : 'light';
          root.dataset.theme = next;
          try { localStorage.setItem('sm-theme', next); } catch (e) {}
          label();
        });
      })();
    </script>
  </body>
</html>
